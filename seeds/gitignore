# Project .gitignore — installed by research-claude apply.sh.
# Source of truth is the single-file manuscript_<project>.qmd (kept). Generated
# output and large/re-acquirable inputs are ignored.

# ── Quarto / render build artifacts (regenerable from the .qmd) ──────────────
.quarto/
*_files/
*_cache/
/_freeze/

# Rendered manuscript output — render locally or in CI; don't version it.
manuscript_*.pdf
manuscript_*.html
manuscript_*.docx
manuscript_*.tex

# LaTeX intermediates
*.aux
*.log
*.bbl
*.bcf
*.blg
*.fls
*.run.xml
*.toc
*.out
*.synctex.gz

# ── Data ─────────────────────────────────────────────────────────────────────
# Raw inputs are large / re-acquirable: ignore everything under data/raw/ but
# keep the provenance manifest and hash-freeze record so inputs stay auditable.
data/raw/**
!data/raw/data_manifest.md
!data/raw/MANIFEST.sha256

# ── Language toolchain outputs ───────────────────────────────────────────────
# R
*.Rds
*.rds
*.RData
*.rda
.Rhistory
.Rproj.user/
# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.ipynb_checkpoints/

# ── Local-only Claude state (machine-specific paths stay out of git) ─────────
.claude/state/obsidian-config.md

# ── Editor / OS ──────────────────────────────────────────────────────────────
.DS_Store

# Pipeline: linked from research-claude, not project content.
# Run ./bootstrap-pipeline.sh to materialize.
#
# The `/*` form (not `.claude/skills/`) is deliberate: git cannot re-include a
# path inside an excluded DIRECTORY, so excluding the directory itself makes the
# negation pattern below silently dead — and this project's OWN skills, agents,
# rules and hooks (the real files that shadow a linked item) would drop out of
# the repo entirely. A coauthor's clone would then be missing them.
.claude/skills/*
.claude/agents/*
.claude/rules/*
.claude/hooks/*
.claude/scripts/*
.claude/templates/*
# Session mechanics, never provenance
quality_reports/agent_dispatch.jsonl
/.pipeline/

# Project overrides — real files, not links. These ARE project content, so
# add a negation line for each one you keep. Example:
# !.claude/skills/my-project-specific-skill/
# !.claude/hooks/my-notify.sh
# !.claude/templates/my-project-template.md
